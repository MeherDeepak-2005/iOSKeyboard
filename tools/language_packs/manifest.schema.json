{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glyph.example/schemas/language-pack-v2.json",
  "title": "Glyph Language Pack Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "identifier",
    "version",
    "locale",
    "input_modes",
    "normalization",
    "minimum_ios",
    "release_status",
    "benchmark_version",
    "native_speaker_reviewed",
    "artifacts",
    "provenance"
  ],
  "properties": {
    "schema_version": { "enum": [1, 2] },
    "identifier": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "locale": { "type": "string", "minLength": 2 },
    "input_modes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["english", "tenglish", "tenglish_to_telugu", "roman_telugu", "telugu"] }
    },
    "normalization": { "const": "NFC" },
    "minimum_ios": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "release_status": { "enum": ["research", "validated", "production"] },
    "benchmark_version": { "type": "string", "minLength": 1 },
    "benchmark_hash": {
      "oneOf": [
        { "$ref": "#/$defs/sha256" },
        { "type": "null" }
      ]
    },
    "native_speaker_reviewed": { "type": "boolean" },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layout", "lexicon", "transliteration_lexicon", "transliteration_fst", "language_model", "safety", "benchmark"],
      "properties": {
        "layout": { "$ref": "#/$defs/artifactOrNull" },
        "lexicon": { "$ref": "#/$defs/artifactOrNull" },
        "transliteration_lexicon": { "$ref": "#/$defs/artifactOrNull" },
        "transliteration_fst": { "$ref": "#/$defs/artifactOrNull" },
        "language_model": { "$ref": "#/$defs/artifactOrNull" },
        "safety": { "$ref": "#/$defs/artifactOrNull" },
        "benchmark": { "$ref": "#/$defs/artifactOrNull" }
      }
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "url", "license", "license_url", "sha256", "split", "purpose"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri" },
          "license": { "type": "string", "minLength": 1 },
          "license_url": { "type": "string", "format": "uri" },
          "sha256": { "$ref": "#/$defs/sha256" },
          "split": { "enum": ["train", "validation", "test", "none"] },
          "purpose": { "enum": ["training", "calibration", "evaluation", "layout", "safety"] },
          "source_revision": { "type": "string", "minLength": 1 },
          "attribution": { "type": "string", "minLength": 1 },
          "research_only": { "type": "boolean" },
          "release_eligible": { "type": "boolean" }
        }
      }
    },
    "build": {
      "type": "object",
      "description": "Optional research-only build statistics; never used as release evidence."
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes", "format"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 1 },
        "format": { "type": "string", "minLength": 1 }
      }
    },
    "artifactOrNull": {
      "oneOf": [
        { "$ref": "#/$defs/artifact" },
        { "type": "null" }
      ]
    }
  }
}
