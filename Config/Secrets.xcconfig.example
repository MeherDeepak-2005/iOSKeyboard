// Duplicate as Secrets.xcconfig for internal model paths. Do not commit it.
// Configure KLIPY separately with tools/configure_klipy.sh.

// Internal profiling builds only. Ordinary Debug and Release bundle nothing.

// W8 transformer rescorer (retired for this edition; set _ENABLED = YES + the
// INTERNAL_NEURAL Swift compile flag to revive it).
INTERNAL_NEURAL_MODEL_PACKAGE = /Users/meher/Downloads/qwen_lm_distil/artifacts/coreml_internal/finetune-w8.mlpackage
INTERNAL_NEURAL_TOKENIZER_MODEL = /Users/meher/Downloads/qwen_lm_distil/artifacts/spm.model
INTERNAL_NEURAL_ENABLED = NO

// GRU streaming search prior (NN-LM in the trie). Export it with
// tools/lm/export_gru_coreml.py; pair _ENABLED = YES with the INTERNAL_GRU Swift
// compile flag to bundle it and wire it into contextSearchPrior.
INTERNAL_GRU_MODEL_PACKAGE = /Users/meher/Downloads/xcode-projects/keyboard/tools/lm/data/gru.mlpackage
INTERNAL_GRU_TOKENIZER_MODEL = /Users/meher/Downloads/xcode-projects/keyboard/tools/lm/data/spm.model
INTERNAL_GRU_ENABLED = NO
