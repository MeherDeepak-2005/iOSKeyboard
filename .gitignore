## --- Xcode ---
## User settings and personal layouts that change constantly
xcuserdata/
*.xcuserstate
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3

## Xcode 13+ and Swift Playgrounds caches
.ccache
*.xcscmblueprint
*.xccheckout

## --- Build Artifacts ---
## Where Xcode compiles your app; sharing this wastes space and causes conflicts
build/
DerivedData/
Products/

## --- Swift Package Manager ---
## SPM downloads dependencies here automatically; no need to track them
.build/
.swiftpm/

## --- Dependency Managers (Optional) ---
## Un-comment these if you use CocoaPods or Carthage
# Pods/
# Carthage/Build/

## --- Secrets and Configurations ---
## Block environment files and configuration files holding sensitive API keys
.env
.env.*
GoogleService-Info.plist
*Secret*.swift
*Config*.plist
Config/Secrets.xcconfig
Config/Klipy.xcconfig

## --- OS / System Files ---
## Folder attributes created by macOS
.DS_Store
.AppleDouble
.LSOverride
._*

## --- Language-data build cache (tools/build_language_data.py) ---
tools/.cache
tools/lm/data/
# Python caching
__pycache__/
*.pyc

# ML Weights & Binaries
*.pt
*.bin
!keyboard/emoji.bin
!keyboard/langdata.bin
!keyboard/telugu_langdata.bin
!keyboard/tenglish_lexicon.bin
*.kbguard
!keyboard/safety.kbguard
*.mlpackage/

# JetBrains IDE
.idea/

# graphify knowledge-graph output
graphify-out/

*.txt
!keyboard/ThirdPartyNotices.txt
!tools/data/google_profanity_en.txt
!tools/data/google_profanity_shidouuu_en.txt
